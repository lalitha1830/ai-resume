# Environment variables — copy this file to .env and fill in the values.
# NEVER commit the .env file to Git.

# Flask secret key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_random_secret_key

# Google Gemini API key — get yours at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model name — check supported models at https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.8-flash

# Flask environment (development or production)
FLASK_ENV=development

# Flask debug mode (True for development, False for production)
FLASK_DEBUG=True
